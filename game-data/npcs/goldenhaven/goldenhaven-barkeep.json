  "greeting": {
    "first_time": "Ahoy! Welcome to The Salty Anchor! I'm Captain Reylia Stormwave. We've got cold beer, warm beds, and the loudest, rowdiest music on the river! What brings ye here, sailor?",
    "returning": "Back again, are ye? What'll it be today?",
    "tired": "Ye look like ye been through a storm! Get yerself a room and some rest!"
  },
  "dialogue": {
    "sleeping": {
      "text": "*snoring like waves crashing* Zzz... *grumbles* ...full sails ahead... Zzz...",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "Just checkin' the rigging! The tavern's open—help yerself below deck!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "What can I do for ye, sailor?",
      "options": [
        "buy_drink",
        "ask_rent_room",
        "ask_about_shows",
        "goodbye"
      ]
    },
    "buy_drink": {
      "text": "Best beer this side of the mountains, brewed strong as the spring flood! Take a look!",
      "action": "open_shop",
      "options": [
        "main_menu"
      ]
    },
    "ask_rent_room": {
      "text": "A hammock for the night costs 50 gold. Sleeps like ye're rockin' on the waves! Want it?",
      "options": [
        "confirm_rent_room",
        "main_menu"
      ]
    },
    "confirm_rent_room": {
      "text": "",
      "action": "rent_room",
      "cost": 50,
      "requirements": {
        "gold": 50
      },
      "success": "Aye! Yer hammock's ready below deck. Sleep well, sailor!",
      "failure": "Ye need 50 gold for a room. Come back when ye got the coin!",
      "options": [
        "main_menu"
      ]
    },
    "ask_about_shows": {
      "text": "Every night at 9 PM, we have the loudest music on the river! River shanties, drums, horns—music that carries across the water! Book before 8 PM and bring yer instrument. Book and don't show, and the whole river hears of it. Want to see what's on tonight?",
      "options": [
        "see_available_shows",
        "main_menu"
      ]
    },
    "see_available_shows": {
      "text": "Let's see what we got lined up...",
      "action": "book_show",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Fair winds and following seas!",
      "action": "end_dialogue"
    },
    "night_bell": {
      "text": "*You ring the little bell on the counter. After a while Reylia shuffles out from the back, bleary-eyed.* A room, at this hour? Aye, there's a bed made up.",
      "options": [
        "ask_rent_room",
        "goodbye"
      ]
    }
  },
