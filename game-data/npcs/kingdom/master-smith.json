  "greeting": {
    "first_time": "Mind the anvil. I'm Edric Thorne, and everything on these racks came off my forge. Looking to arm yourself properly?",
    "returning": "Back again. Something chip, or are you finally ready for real armour?",
    "low_gold": "I've bought more steel today than I've sold. Come back tomorrow when the coffer's full."
  },
  "dialogue": {
    "sleeping": {
      "text": "*a deep, rumbling snore from behind the door*",
      "options": ["goodbye"]
    },
    "traveling_to_work": {
      "text": "The forge has to be hot before the first customer walks in. Come by when the bell rings at seven.",
      "options": ["goodbye"]
    },
    "traveling_home": {
      "text": "The fires are banked for the night. Steel will still be there in the morning.",
      "options": ["goodbye"]
    },
    "off_duty": {
      "text": "I'm done swinging a hammer for today. The Grand Forge opens at seven.",
      "options": ["goodbye"]
    },
    "main_menu": {
      "text": "Blades, polearms, mail. What do you need?",
      "options": ["browse_shop", "ask_about_forge", "goodbye"]
    },
    "browse_shop": {
      "text": "Take your time. Heft them before you buy; a weapon should feel like part of your arm.",
      "action": "open_shop"
    },
    "ask_about_forge": {
      "text": "The Grand Forge has armed the royal guard for three generations. I buy back good steel at a fair price, but don't bring me tools or trinkets. Plate? I don't sell it. Plate that's worth wearing is taken off the dead, not bought.",
      "options": ["main_menu"]
    },
    "goodbye": {
      "text": "Keep your edge oiled.",
      "action": "end_dialogue"
    }
  },
