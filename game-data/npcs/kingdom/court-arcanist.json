  "greeting": {
    "first_time": "Corvin Ashgrove, Court Arcanist. You've the look of someone who has run out of something important. Reagents? Ink? Patience?",
    "returning": "Ah, you again. Do try not to set anything on fire this time.",
    "low_gold": "The tower's coffers are spent for today. Bring your curiosities back tomorrow."
  },
  "dialogue": {
    "sleeping": {
      "text": "*Behind the door, a voice mutters an incantation in its sleep, then a soft snore.*",
      "options": ["goodbye"]
    },
    "traveling_to_work": {
      "text": "The tower opens at eight, not a minute sooner. Magic keeps a schedule even if wizards don't.",
      "options": ["goodbye"]
    },
    "traveling_home": {
      "text": "The counter is closed. Whatever you need will still be unstable tomorrow.",
      "options": ["goodbye"]
    },
    "off_duty": {
      "text": "I am reading, which is to say I am busy. The tower opens at eight.",
      "options": ["goodbye"]
    },
    "main_menu": {
      "text": "Components, a focus, a fresh spellbook? State your need precisely.",
      "options": ["browse_shop", "ask_about_tower", "goodbye"]
    },
    "browse_shop": {
      "text": "Everything is labelled. Please do not lick the crystals.",
      "action": "open_shop"
    },
    "ask_about_tower": {
      "text": "The court's wizards study here; I keep them supplied. Spellbooks and component pouches are hand-stitched and slow to replace, so I keep only one of each. As for wands, orbs and the like, a proper focus is attuned by its maker, and those makers rarely part with them while they're alive.",
      "options": ["main_menu"]
    },
    "goodbye": {
      "text": "Mind the third step on your way out. It bites.",
      "action": "end_dialogue"
    }
  },
