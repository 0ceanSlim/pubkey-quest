  "greeting": {
    "first_time": "Welcome, welcome! Aldric Goodsworth at your service. Looking for supplies? You've come to the right place—I've got everything an adventurer needs!",
    "returning": "Ah, back again! What can I get for you today?",
    "low_gold": "Business has been good today—my purse is getting a bit light. I may not be able to buy much more from you right now."
  },
  "dialogue": {
    "sleeping": {
      "text": "*snoring* Zzz... five more minutes...",
      "options": [
        "goodbye"
      ]
    },
    "traveling_to_work": {
      "text": "Morning! Heading to the shop to open up. Stop by if you need supplies!",
      "options": [
        "goodbye"
      ]
    },
    "traveling_home": {
      "text": "Shop's closed for the night, friend. I'm heading home to rest these old bones. Come back tomorrow!",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "I'm off the clock for the evening. Visit me at the Grand Market tomorrow during business hours!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "What brings you to my shop today?",
      "options": [
        "browse_shop",
        "ask_about_stock",
        "goodbye"
      ]
    },
    "browse_shop": {
      "text": "Have a look around! All my prices are fair—you won't find better deals in the kingdom.",
      "action": "open_shop"
    },
    "ask_about_stock": {
      "text": "I restock my shelves every morning with fresh supplies from local craftsmen and traders. If something's out of stock, check back tomorrow!",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Safe travels, friend! Come back anytime!",
      "action": "end_dialogue"
    }
  },
