  "greeting": {
    "first_time": "Welcome to Silverstring. I am Aerin. Draw any bow on the rack; you'll know the right one when it stops fighting you.",
    "returning": "Welcome back. How has your string held?",
    "low_gold": "My purse is light today. Return tomorrow and I will gladly buy."
  },
  "dialogue": {
    "sleeping": {
      "text": "*Only the creak of the trees answers.*",
      "options": ["goodbye"]
    },
    "traveling_to_work": {
      "text": "The bowyery opens at eight, once the morning dew is off the staves.",
      "options": ["goodbye"]
    },
    "traveling_home": {
      "text": "The light is going, and so am I. Tomorrow at eight.",
      "options": ["goodbye"]
    },
    "off_duty": {
      "text": "The workshop is closed. Come back at eight.",
      "options": ["goodbye"]
    },
    "main_menu": {
      "text": "Bows, arrows, something light to wear in the trees?",
      "options": ["browse_shop", "ask_about_bows", "goodbye"]
    },
    "browse_shop": {
      "text": "Take your time. A good bow is chosen slowly and kept for life.",
      "action": "open_shop"
    },
    "ask_about_bows": {
      "text": "Yew for longbows, ash for short. Each stave cures a full season before I shape it. Arrows I fletch myself, with grey goose. Crossbows? Those are dwarf-work. Ask the Hammerfalls in Ironpeak.",
      "options": ["main_menu"]
    },
    "goodbye": {
      "text": "May your arrows fly true.",
      "action": "end_dialogue"
    }
