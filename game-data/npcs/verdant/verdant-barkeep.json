  "greeting": {
    "first_time": "Welcome to The Moonlit Glade, traveler. I am Faelyn, keeper of this sanctuary. May the forest's peace find you here. We offer rest, refreshment, and music beneath the stars.",
    "returning": "The trees welcome your return, friend. How may I help you?",
    "tired": "You seem weary. Perhaps the embrace of nature and a soft bed would restore you?"
  },
  "dialogue": {
    "sleeping": {
      "text": "*sleeping peacefully* ...the trees whisper... *soft breathing*",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "I'm tending to the grove right now. The inn is open—feel free to make yourself comfortable!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "How may the Glade serve you?",
      "options": [
        "buy_drink",
        "ask_rent_room",
        "ask_about_shows",
        "goodbye"
      ]
    },
    "buy_drink": {
      "text": "I have beer brewed with forest herbs—refreshing and pure. Take a look!",
      "action": "open_shop",
      "options": [
        "main_menu"
      ]
    },
    "ask_rent_room": {
      "text": "A room here costs 50 gold. You'll sleep beneath the canopy, where the stars shine through the leaves and the forest sings you to rest. Would you like to stay?",
      "options": [
        "confirm_rent_room",
        "main_menu"
      ]
    },
    "confirm_rent_room": {
      "text": "",
      "action": "rent_room",
      "cost": 50,
      "requirements": {
        "gold": 50
      },
      "success": "Wonderful! Your room is among the upper branches. May the forest grant you peaceful dreams.",
      "failure": "I'm sorry, but a room costs 50 gold. The forest will be here when you're ready.",
      "options": [
        "main_menu"
      ]
    },
    "ask_about_shows": {
      "text": "Every evening at 9 PM, we have live music here beneath the trees. Gentle melodies that honor nature—lutes, flutes, lyres, and such. Book before 8 PM and bring your instrument. An empty stage after a promise is remembered here for a day. Want to see tonight's performance?",
      "options": [
        "see_available_shows",
        "main_menu"
      ]
    },
    "see_available_shows": {
      "text": "Let me show you what's planned...",
      "action": "book_show",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "May the forest's blessings walk with you.",
      "action": "end_dialogue"
    },
    "night_bell": {
      "text": "*You ring the little bell on the counter. After a while Faelyn shuffles out from the back, bleary-eyed.* A room, at this hour? Aye, there's a bed made up.",
      "options": [
        "ask_rent_room",
        "goodbye"
      ]
    }
  },
