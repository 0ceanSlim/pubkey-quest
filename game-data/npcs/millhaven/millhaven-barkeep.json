  "greeting": {
    "first_time": "Welcome to The Grain & Grape! I'm Marigold, your host. Whether you need a drink, a room, or a stage to perform on, I've got you covered!",
    "returning": "Welcome back, dear! What can I do for you today?",
    "tired": "You look exhausted! Perhaps a room and a good night's rest?"
  },
  "dialogue": {
    "sleeping": {
      "text": "*snoring softly* Zzz... *mumbles* ...fresh bread in the morning... Zzz...",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "Just taking a short break! The inn is open—help yourself downstairs!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "What brings you to The Grain & Grape?",
      "options": [
        "buy_drink",
        "ask_rent_room",
        "ask_about_shows",
        "goodbye"
      ]
    },
    "buy_drink": {
      "text": "I've got cold beer fresh from the cellar. Take a look!",
      "action": "open_shop",
      "options": [
        "main_menu"
      ]
    },
    "ask_rent_room": {
      "text": "A room for the night costs 50 gold. Includes a comfortable bed and a hearty breakfast. Would you like to rent a room?",
      "options": [
        "confirm_rent_room",
        "main_menu"
      ]
    },
    "confirm_rent_room": {
      "text": "",
      "action": "rent_room",
      "cost": 50,
      "requirements": {
        "gold": 50
      },
      "success": "Wonderful! Your room is upstairs, second door on the left. Sleep well!",
      "failure": "I'm sorry, dear, but a room costs 50 gold. Come back when you have enough.",
      "options": [
        "main_menu"
      ]
    },
    "ask_about_shows": {
      "text": "We have live music every night at 9 PM! All musicians are welcome here—we love a good performance! Shows vary by the day. Bookings close at 8 PM; just bring your instrument along. If you book and don't come, folk talk, and it'll take a day to live down. Want to see tonight's options?",
      "options": [
        "see_available_shows",
        "main_menu"
      ]
    },
    "see_available_shows": {
      "text": "Let me check what's available tonight...",
      "action": "book_show",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Safe travels! Come back anytime!",
      "action": "end_dialogue"
    },
    "night_bell": {
      "text": "*You ring the little bell on the counter. After a while Marigold shuffles out from the back, bleary-eyed.* A room, at this hour? Aye, there's a bed made up.",
      "options": [
        "ask_rent_room",
        "goodbye"
      ]
    }
  },
