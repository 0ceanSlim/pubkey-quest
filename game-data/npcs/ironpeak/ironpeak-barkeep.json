  "greeting": {
    "first_time": "Welcome to The Pickaxe & Pint! I'm Helga Stonebrew. Fresh from the mines? I've got cold drinks, warm beds, and music that'll shake the mountain!",
    "returning": "Back again, are ye? What'll it be?",
    "tired": "Ye look like ye been diggin' all day! Get yerself a room and some rest!"
  },
  "dialogue": {
    "sleeping": {
      "text": "*snoring like thunder* Zzz... *grumbles* ...double shift in the mines... Zzz...",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "Takin' a breather! The inn's open—help yerself!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "What can I get for ye?",
      "options": [
        "buy_drink",
        "ask_rent_room",
        "ask_about_shows",
        "goodbye"
      ]
    },
    "buy_drink": {
      "text": "Best beer in the mountains, brewed by me own hands! Have a look!",
      "action": "open_shop",
      "options": [
        "main_menu"
      ]
    },
    "ask_rent_room": {
      "text": "A room's 50 gold. Ye get a sturdy bed and breakfast fit for a miner. Interested?",
      "options": [
        "confirm_rent_room",
        "main_menu"
      ]
    },
    "confirm_rent_room": {
      "text": "",
      "action": "rent_room",
      "cost": 50,
      "requirements": {
        "gold": 50
      },
      "success": "Aye! Yer room is upstairs, first door on the right. Sleep sound!",
      "failure": "Ye need 50 gold for a room. Come back when ye got it!",
      "options": [
        "main_menu"
      ]
    },
    "ask_about_shows": {
      "text": "We have music every night at 9 PM! Loud, rhythmic stuff the miners love—nothin' fancy! Book before 8 PM and bring yer instrument. Leave my miners waitin' and every tunnel in the mountain will know yer name. Want to see what's on tonight?",
      "options": [
        "see_available_shows",
        "main_menu"
      ]
    },
    "see_available_shows": {
      "text": "Let's see what we got...",
      "action": "book_show",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "May yer path be as steady as stone!",
      "action": "end_dialogue"
    },
    "night_bell": {
      "text": "*You ring the little bell on the counter. After a while Helga shuffles out from the back, bleary-eyed.* A room, at this hour? Aye, there's a bed made up.",
      "options": [
        "ask_rent_room",
        "goodbye"
      ]
    }
  },
