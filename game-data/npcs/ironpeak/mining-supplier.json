  "greeting": {
    "first_time": "Aye, welcome! Brogni Ironhand's the name. Ye need supplies that won't fail ye in the depths? Ye've come to the right place!",
    "returning": "Back again, eh? Good to see ye. What'll it be?",
    "low_gold": "Business has been brisk today—my coin pouch is runnin' dry. Can't buy much more 'til I make some sales."
  },
  "dialogue": {
    "sleeping": {
      "text": "*snoring loudly* Zzzz... *mumbles about ore prices*",
      "options": [
        "goodbye"
      ]
    },
    "traveling_to_work": {
      "text": "Mornin'! Headin' to the shop to open up. Stop by if ye need quality gear!",
      "options": [
        "goodbye"
      ]
    },
    "traveling_home": {
      "text": "Shop's closed for the night, friend. I'm headin' home. Come back tomorrow!",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "I'm off duty, friend. Visit me shop during business hours if ye need supplies!",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "What can I get for ye?",
      "options": [
        "browse_shop",
        "ask_about_durability",
        "goodbye"
      ]
    },
    "browse_shop": {
      "text": "Take a look! Every item built to last—dwarven quality, guaranteed. No shoddy goods here!",
      "action": "open_shop",
      "options": [
        "main_menu"
      ]
    },
    "ask_about_durability": {
      "text": "Every piece o' gear in this shop is tested personal-like. If it can't survive a trip into the mines, it don't make it onto me shelves. That's the dwarven way!",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Stone and steel keep ye safe! Come back anytime!",
      "action": "end_dialogue"
    }
  },
