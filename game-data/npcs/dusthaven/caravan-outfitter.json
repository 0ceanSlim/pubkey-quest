  "greeting": {
    "first_time": "Tariq Sandwalker. Heading into the Sunscorch? Then let's make sure you come back out of it.",
    "returning": "Still alive. Good. What did the desert take from you this time?",
    "low_gold": "No coin to buy with today; the last caravan cleaned me out. Tomorrow."
  },
  "dialogue": {
    "sleeping": {
      "text": "*The shutters are closed. Only the wind answers.*",
      "options": ["goodbye"]
    },
    "traveling_to_work": {
      "text": "I open at six, before the heat. Smart travellers buy early and leave early.",
      "options": ["goodbye"]
    },
    "traveling_home": {
      "text": "Shop's shut. Nobody sensible trades in the evening heat. Six tomorrow.",
      "options": ["goodbye"]
    },
    "off_duty": {
      "text": "Closed. Come back at six, and drink some water while you wait.",
      "options": ["goodbye"]
    },
    "main_menu": {
      "text": "Water, food, a blade? The desert wants all three.",
      "options": ["browse_shop", "ask_about_desert", "goodbye"]
    },
    "browse_shop": {
      "text": "Waterskins first. Everything else second.",
      "action": "open_shop"
    },
    "ask_about_desert": {
      "text": "The Sunscorch kills three ways: thirst, heat, and the things that hunt in it. Gnolls, jackalweres, dust mephits that blind you before they bite. Carry more water than you think, travel at dawn, and keep a scimitar handy. The desert respects curved steel.",
      "options": ["main_menu"]
    },
    "goodbye": {
      "text": "Travel at dawn. Come back.",
      "action": "end_dialogue"
    }
  },
