    },
    "main_menu": {
      "text": "What does the well offer you today?",
      "options": [
        "browse_shop",
        "ask_about_well",
        "goodbye"
      ]
    },
    "browse_shop": {
      "text": "Holy water, healing draughts, incense and oil. The spirits ask a fair price, and the shrine needs a new roof.",
      "action": "open_shop"
    },
    "ask_about_well": {
      "text": "The well has never run dry, not in the worst summer anyone remembers. The caravan masters say a blessing here before every crossing. Holy water and a healing draught weigh little next to a death in the dunes.",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Go well.",
