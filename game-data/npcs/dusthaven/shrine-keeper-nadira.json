  "greeting": {
    "first_time": "Peace of the well on you, traveller. I keep the shrine. The spirits' water and the temple's remedies are here, for those headed into the sand.",
    "returning": "Back from the sand? Drink, then tell me what you need."
  },
  "dialogue": {
