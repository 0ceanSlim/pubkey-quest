  "greeting": {
    "first_time": "Fresh off the boats! Gull Marrow, best fish on the coast. I buy and I sell, and I pay better than any shopkeeper for a good catch.",
    "returning": "Brought me something with fins? Let's see it."
  },
  "dialogue": {
    "sleeping": {
      "text": "*Asleep. Best come back in the morning.*",
      "options": [
        "goodbye"
      ]
    },
    "traveling_to_work": {
      "text": "On my way to open up. I'm open from 5 in the morning to 2 in the afternoon.",
      "options": [
        "goodbye"
      ]
    },
    "traveling_home": {
      "text": "Closed for the day, friend. I open again at 5 in the morning.",
      "options": [
        "goodbye"
      ]
    },
    "off_duty": {
      "text": "Not now. Come by when I'm open: 5 in the morning to 2 in the afternoon.",
      "options": [
        "goodbye"
      ]
    },
    "main_menu": {
      "text": "Buying or selling?",
      "options": [
        "browse_shop",
        "ask_about_market",
        "goodbye"
      ]
    },
    "browse_shop": {
      "text": "Fresh, salted, cooked. And bring me your catch: I pay fair for fish.",
      "action": "open_shop"
    },
    "ask_about_market": {
      "text": "Boats come in before dawn, market's done by two. Fresh fish fetch the best price, so don't let your catch sit in your pack: by the end of the day it's half the coin, and spoiled it's worth nothing. Salt it if you're travelling.",
      "options": [
        "main_menu"
      ]
    },
    "goodbye": {
      "text": "Go well.",
      "action": "end_dialogue"
